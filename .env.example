# ==========================================
# Meeting Room Booking System - Environment Variables
# ==========================================

# Application Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ระบบจองห้องประชุมออนไลน์"

# Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-token-change-in-production-min32chars
JWT_EXPIRES_IN=7d

# Default System Timezone
NEXT_PUBLIC_TIMEZONE=Asia/Bangkok

# Google Cloud Service Account Integration
# To enable live Google Sheets & Drive sync, set these 4 values:
GOOGLE_SERVICE_ACCOUNT_EMAIL=meeting-room-service@your-project-id.iam.gserviceaccount.com
# Format: Use literal \n in string or newline escaped
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Mode: Set to 'true' to use Google Sheets/Drive as primary database.
# If 'false' or if Google credentials are missing, system seamlessly uses Local Persistent JSON store.
USE_GOOGLE_SHEETS=false

# Real-time Events Settings
EVENT_POLL_INTERVAL_MS=60000
